[Unit]
Description=Pi Motion Camera
After=network.target sound.target

[Service]
Type=simple
User=YOUR_USER
SupplementaryGroups=audio
EnvironmentFile=/etc/pi-motion-cam.env
WorkingDirectory=/home/YOUR_USER/pi-motion-cam
ExecStart=/home/YOUR_USER/pi-motion-cam/.venv/bin/python camera.py --camera 0 --host 0.0.0.0 --port 8080 --width 640 --height 480 --fps 15 --sensitivity 5 --cooldown 20 --pre-roll 5 --audio-device plughw:1,0 --audio-rate 16000 --recordings /home/YOUR_USER/pi-motion-cam/recordings
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
